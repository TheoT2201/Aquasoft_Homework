{
  "inputSource": "https://www.tripadvisor.com/Hotel_Review-g2486879-d1063944-Reviews-Wattle_Grove_Motel-Wattle_Grove_Greater_Perth_Western_Australia.html",
  "id": 878748328,
  "createdDate": "2023-02-15",
  "publishedDate": "2023-02-14",
  "provider": null,
  "rating": 1,
  "publishPlatform": "OTHER",
  "translationType": null,
  "ownerResponse": {
    "id": 878978235,
    "translationType": null,
    "publishedDate": "2023-02-16",
    "language": "en",
    "text": "Hi there Aussieretired1, \n\nThank you for your comments and for your email response to your cancellation request.\n\nAs per our terms and conditions, we require to sight your current photo ID and credit card on arrival.  Our office hours are listed on all sites and you were arriving outside of office hours hence our need for further information.\n\nPer our terms and conditions on our confirmation, in order for us to leave you a key, we require to identify you so we have comfort that the card being suggested for use is genuine and that you're the cardholder.  \n\nYou didn't allow us to sight your card, you only gave us some numbers and unfortunately, this was insufficient.  You did not furnish us with your photo ID despite your comments above.\n\nWith online platforms, it is very easy, without safeguards in place for someone to perform credit card fraud and I'd have thought that you'd be be provided with a sense of comfort that we wouldn't simply accept 16 digits from your card without ensuring you, as the cardholder had given us the proper authority to charge and it is our firm belief that our procedure is one that protects you, the cardholder and the property, the merchant.\n\nI sincerely hope you enjoy your stay in town no matter where you land and that the magnificent Perth weather turns it on for you.",
    "username": "Karen B",
    "connectionToSubject": "General Manager",
    "userProfile": {
      "avatar": {
        "photoSizes": [
          {
            "width": 1200,
            "height": 1200,
            "url": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f0/9f/default-avatar-2020-16.jpg?w=1200&h=-1&s=1"
          }
        ]
      }
    }
  },
